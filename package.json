{
  "name": "aks-campus-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-cesium.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:models": "node scripts/validate-blender.mjs",
    "test:moving": "node scripts/check-moving-assets.mjs",
    "test:browser": "node scripts/check-interactions.mjs",
    "test:regressions": "node scripts/check-regressions.mjs",
    "assets:export": "node scripts/export-blender-input.mjs --all",
    "assets:metadata": "node --import tsx scripts/publish-model-metadata.ts",
    "postinstall": "node scripts/copy-cesium.mjs"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "latest",
    "gltf-validator": "^2.0.0-dev.3.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
